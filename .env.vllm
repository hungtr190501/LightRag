# vLLM Configuration
LLM_MODEL=qwen3-14b
LLM_BINDING_HOST=http://192.168.2.181:9061/v1
LLM_BINDING_API_KEY=not_needed

# Embedding Configuration
EMBEDDING_MODEL=bge-m3
EMBEDDING_BINDING_HOST=http://192.168.2.181:9062/v1
EMBEDDING_BINDING_API_KEY=not_needed
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=4096

# Reranker Configuration
RERANK_MODEL=reranker
RERANK_BINDING_HOST=http://192.168.2.182:8787/api/v1/rerank
RERANK_BINDING_API_KEY=not_needed

# OCR Configuration (PaddleOCR-VL via REST API)
OCR_HOST=http://192.168.2.182:7800
OCR_API_KEY=not_needed

# Storage Configuration (tùy chọn)
KV_STORAGE=JsonKVStorage
DOC_STATUS_STORAGE=JsonDocStatusStorage
VECTOR_STORAGE=JsonVectorStorage
GRAPH_STORAGE=NetworkxStorage

# Qdrant — Legal RAG vector storage (legal chunks, hybrid search)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# LightRAG chunk size — giảm để vừa với context 4096 của model
# chunk(600) + extraction_prompt(~2800) + output(512) ≈ 3900 < 4096
CHUNK_SIZE=600
CHUNK_OVERLAP_SIZE=50
